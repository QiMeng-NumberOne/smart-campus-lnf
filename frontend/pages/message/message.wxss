/* 消息页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.publish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 15px;
  height: 50px;
  background-color: #1a73e8;
  color: white;
}

.publish-header-title {
  font-size: 16px;
  font-weight: bold;
}

.menu-section {
  background-color: white;
  margin-bottom: 12px;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.menu-icon {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}

.menu-title {
  font-size: 14px;
  color: #333;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.menu-arrow {
  color: #999;
  font-size: 14px;
}

.badge {
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 9px;
  background: #ff4d4f;
  color: #fff;
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}

.read-status {
  font-size: 12px;
  color: #999;
}