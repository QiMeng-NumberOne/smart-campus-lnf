<view class="container">
  <view class="login-logo">
    <view class="logo-icon">
      <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#1a73e8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </view>
  </view>
  <view class="login-title">校园失物招领</view>
  <view class="login-subtitle">智能匹配·快速找回·物归原主</view>
  
  <view class="login-features">
    <button class="feature-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10" opacity="0.2"></path>
        <path d="M12 2a10 10 0 1 0 10 10"></path>
        <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
        <circle cx="12" cy="9" r="3"></circle>
      </svg>
      AI识别
    </button>
    <button class="feature-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="22" y1="12" x2="18" y2="12"></line>
        <line x1="6" y1="12" x2="2" y2="12"></line>
        <line x1="12" y1="6" x2="12" y2="2"></line>
        <line x1="12" y1="22" x2="12" y2="18"></line>
      </svg>
      定位寻物
    </button>
    <button class="feature-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
      </svg>
      智能匹配
    </button>
    <button class="feature-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      </svg>
      实时通知
    </button>
  </view>
  
  <view class="login-stats">
    <view class="stat-item">
      <view class="stat-number">2,847</view>
      <view class="stat-label">成功找回</view>
    </view>
    <view class="stat-item">
      <view class="stat-number">15,320</view>
      <view class="stat-label">注册用户</view>
    </view>
    <view class="stat-item">
      <view class="stat-number">96%</view>
      <view class="stat-label">匹配准确率</view>
    </view>
  </view>
  
  <view class="login-agreement">
    <checkbox id="agreement" checked="{{agreementChecked}}" bindchange="onAgreementChange"></checkbox>
    <label for="agreement">我已阅读并同意《用户协议》和《隐私政策》</label>
  </view>
  
  <button class="login-btn wechat-login" bindtap="handleWechatLogin">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="#1a73e8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
    </svg>
    微信一键登录
  </button>
  <button class="login-btn guest-login" bindtap="goToGuestMode">游客模式浏览</button>
  
  <view class="login-footer">仅限在校师生使用 · 本校官方失物招领平台</view>
</view>

<!-- 隐私提示弹窗 -->
<view class="modal" wx:if="{{showPrivacyModal}}">
  <view class="modal-content">
    <view class="modal-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ff9800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      隐私提示
    </view>
    <view class="modal-body">
      使用前请阅读并同意我们的《用户协议》和《隐私政策》，我们承诺保护您的个人信息安全。
    </view>
    <view class="modal-buttons">
      <button class="modal-button" bindtap="hidePrivacyModal">暂不同意</button>
      <button class="modal-button primary" bindtap="goToHome">同意并继续</button>
    </view>
  </view>
</view>