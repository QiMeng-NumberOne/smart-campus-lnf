<view class="container">
  <view class="login-logo">
    <image class="logo-img" src="/images/login.jpg" mode="aspectFit" />
  </view>
  <view class="login-title">西南大学校园失物招领</view>
  <view class="login-subtitle">智能匹配·快速找回·物归原主</view>
  
  <view class="login-features">
    <button class="feature-btn">AI识别</button>
    <button class="feature-btn">定位寻物</button>
    <button class="feature-btn">智能匹配</button>
    <button class="feature-btn">实时通知</button>
  </view>
  
  <view class="login-stats">
    <view class="stat-item">
      <view class="stat-number">{{stats.resolvedCount}}</view>
      <view class="stat-label">成功找回</view>
    </view>
    <view class="stat-item">
      <view class="stat-number">{{stats.userCount}}</view>
      <view class="stat-label">注册用户</view>
    </view>
    <view class="stat-item">
      <view class="stat-number">{{stats.resolvedRate}}</view>
      <view class="stat-label">找回认领率</view>
    </view>
  </view>
  
  <view class="login-agreement">
    <checkbox id="agreement" checked="{{agreementChecked}}" bindchange="onAgreementChange"></checkbox>
    <label for="agreement">我已阅读并同意《用户协议》和《隐私政策》</label>
  </view>
  
  <button class="login-btn wechat-login" bindtap="handleWechatLogin">
    微信一键登录
  </button>
  
  <view class="login-footer">仅限在校师生使用 · 本校官方失物招领平台</view>
</view>

<!-- 隐私提示弹窗 -->
<view class="modal" wx:if="{{showPrivacyModal}}">
  <view class="modal-content">
    <view class="modal-title">
      隐私提示
    </view>
    <view class="modal-body">
      使用前请阅读并同意我们的《用户协议》和《隐私政策》，我们承诺保护您的个人信息安全。
    </view>
    <view class="modal-buttons">
      <button class="modal-button" bindtap="hidePrivacyModal">暂不同意</button>
      <button class="modal-button primary" bindtap="goToHome">同意并继续</button>
    </view>
  </view>
</view>