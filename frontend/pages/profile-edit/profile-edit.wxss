.container { min-height: 100vh; background: #f5f5f5; padding: 12px; }
.card { background: #fff; border-radius: 10px; padding: 12px; }
.row { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 10px 0; }
.label { width: 70px; color: #666; font-size: 14px; }
.value { display: flex; align-items: center; gap: 8px; }
.avatar { width: 42px; height: 42px; border-radius: 50%; background: #eee; }
.empty { display: flex; align-items: center; justify-content: center; color: #999; font-size: 12px; }
.input { flex: 1; text-align: right; font-size: 14px; }
.picker-value { min-width: 180px; text-align: right; font-size: 14px; color: #333; }
.save-btn { margin-top: 14px; background: #1a73e8; color: #fff; border-radius: 8px; }
