/* 发布页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.publish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  background-color: white;
  border-bottom: 1px solid #e0e0e0;
}

.publish-header-title {
  font-size: 16px;
  font-weight: 600;
}

.publish-header-btn {
  color: #1a73e8;
  font-size: 14px;
}

.publish-form {
  background-color: white;
  margin: 12px 0;
}

.form-section {
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}

.form-label {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 12px;
  color: #333;
}

.form-hint {
  font-size: 12px;
  color: #999;
  margin-top: -8px;
  margin-bottom: 12px;
}

.upload-area {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.upload-item {
  width: 80px;
  height: 80px;
  border: 1px dashed #e0e0e0;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #999;
  font-size: 12px;
}

.form-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 14px;
  color: #666;
}

.form-select svg {
  margin-right: 8px;
}

.form-arrow {
  color: #999;
  font-size: 14px;
}

.form-input {
  width: 100%;
  padding: 12px 0;
  border: none;
  border-bottom: 1px solid #f0f0f0;
  font-size: 14px;
}

.form-input:focus {
  outline: none;
  border-bottom-color: #1a73e8;
}

.form-textarea {
  width: 100%;
  min-height: 100px;
  padding: 12px;
  border: 1px solid #f0f0f0;
  border-radius: 8px;
  font-size: 14px;
  resize: none;
}

.form-textarea:focus {
  outline: none;
  border-color: #1a73e8;
}

.form-counter {
  font-size: 12px;
  color: #999;
  text-align: right;
  margin-top: 8px;
}

.contact-options {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.contact-option {
  flex: 1;
  padding: 10px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  text-align: center;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #666;
}

.contact-option.active {
  background-color: #e3f2fd;
  border-color: #1a73e8;
  color: #1a73e8;
}

.publish-submit {
  padding: 24px 16px;
}

.submit-btn {
  width: 100%;
  padding: 16px;
  background-color: #1a73e8;
  color: white;
  border: none;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 600;
}