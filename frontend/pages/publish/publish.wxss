/* 发布页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.publish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  background-color: white;
  border-bottom: 1px solid #e0e0e0;
}

.publish-header-title {
  font-size: 16px;
  font-weight: 600;
}

.publish-header-btn {
  color: #1a73e8;
  font-size: 14px;
}

.publish-form {
  background-color: white;
  margin: 12px 0;
}

.form-section {
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}

.form-label {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 12px;
  color: #333;
}

.form-hint {
  font-size: 12px;
  color: #999;
  margin-top: 0;
  margin-bottom: 12px;
}

.upload-area {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.upload-item {
  position: relative;
  width: 80px;
  height: 80px;
  border: 1px dashed #e0e0e0;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #999;
  font-size: 12px;
}

.remove-btn {
  position: absolute;
  right: 4px;
  top: 4px;
  background: #f56c6c;
  color: #fff;
  border-radius: 10px;
  padding: 2px 6px;
  font-size: 12px;
  line-height: 1;
  z-index: 2;
}

.ai-suggest-row {
  margin-top: 12px;
}

.ai-btn {
  width: 100%;
  background: #eef4ff;
  color: #1a73e8;
  border: 1px solid #c9dbff;
}

.ai-tip {
  margin-top: 8px;
  font-size: 12px;
  color: #666;
}

.id-card-box {
  background: #fff7ed;
}

.privacy-warning {
  font-size: 12px;
  color: #b45309;
  margin-bottom: 10px;
  line-height: 1.6;
}

.cert-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.cert-action-btn {
  margin: 0;
  border-radius: 10px;
  height: 44px;
  line-height: 44px;
  font-size: 16px;
  font-weight: 600;
}

.cert-manual-btn {
  background: #ffffff;
}

.cert-hint {
  margin-top: 10px;
  margin-bottom: 6px;
  font-size: 12px;
  color: #7c8799;
  line-height: 1.6;
}

.cert-fields {
  margin-top: 8px;
}

.cert-field-row {
  display: flex;
  align-items: center;
  border-bottom: 1px solid #f0e2cf;
  padding: 10px 0;
}

.cert-field-label {
  width: 90px;
  flex-shrink: 0;
  font-size: 14px;
  color: #7a4a16;
  font-weight: 600;
}

.cert-field-input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 14px;
  color: #333;
  line-height: 1.5;
}

.cert-field-input:focus {
  outline: none;
}

.cert-field-block {
  padding-top: 10px;
}

.cert-address-textarea {
  margin-top: 8px;
  background: #fff;
}

.form-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 14px;
  color: #666;
}

.form-select svg {
  margin-right: 8px;
}

.form-arrow {
  color: #999;
  font-size: 14px;
}

.form-input {
  width: 100%;
  padding: 12px 0;
  border: none;
  border-bottom: 1px solid #f0f0f0;
  font-size: 14px;
}

.form-input:focus {
  outline: none;
  border-bottom-color: #1a73e8;
}

.form-textarea {
  width: 100%;
  min-height: 100px;
  padding: 12px;
  border: 1px solid #f0f0f0;
  border-radius: 8px;
  font-size: 14px;
  resize: none;
}

.form-textarea:focus {
  outline: none;
  border-color: #1a73e8;
}

.form-counter {
  font-size: 12px;
  color: #999;
  text-align: right;
  margin-top: 8px;
}

.contact-options {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.contact-option {
  flex: 1;
  padding: 10px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  text-align: center;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #666;
}

.contact-option.active {
  background-color: #e3f2fd;
  border-color: #1a73e8;
  color: #1a73e8;
}

.publish-submit {
  padding: 24px 16px;
}

.clear-btn {
  width: 100%;
  padding: 14px;
  margin-bottom: 10px;
  background-color: #ffffff;
  color: #6b7280;
  border: 1px solid #d1d5db;
  border-radius: 24px;
  font-size: 15px;
}

.submit-btn {
  width: 100%;
  padding: 16px;
  background-color: #1a73e8;
  color: white;
  border: none;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 600;
}