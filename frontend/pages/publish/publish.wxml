<view class="container">
  <view class="publish-header">
    <view bindtap="goBack">返回</view>
    <view class="publish-header-title">{{pageTitle}}</view>
    <view class="publish-header-btn" bindtap="togglePublishType">{{switchText}}</view>
  </view>
  
  <view class="publish-form">
    <view class="form-section">
      <view class="form-label">上传照片</view>
      <view class="form-hint">最多6张</view>
      <view class="upload-area">
        <block wx:for="{{images}}" wx:key="*this">
          <view class="upload-item">
            <image src="{{item}}" mode="aspectFill" style="width:100%;height:100%;" bindtap="previewImage" data-index="{{index}}"></image>
            <view class="remove-btn" catchtap="removeImage" data-index="{{index}}">删</view>
          </view>
        </block>
        <view class="upload-item" bindtap="chooseImage">
          <view>+ 添加照片</view>
        </view>
      </view>
      <view class="ai-suggest-row">
        <button class="ai-btn" bindtap="detectCategoryByAi" loading="{{aiDetecting}}">AI识别首张图片并推荐分类</button>
        <view wx:if="{{aiSuggestion}}" class="ai-tip">
          建议：{{aiSuggestion.item_type_name || aiSuggestion.item_class || '未知'}}（置信度 {{aiSuggestion.confidence}}，自动填充阈值 {{aiAutoFillThreshold}}）
        </view>
      </view>
    </view>
    
    <view class="form-section">
      <view class="form-label">物品分类</view>
      <view class="form-select" bindtap="chooseCategory">
        {{formData.category || '选择物品类型'}}
        <view class="form-arrow">></view>
      </view>
    </view>

    <view class="form-section id-card-box" wx:if="{{formData.itemTypeId === 9 || formData.category === '证件'}}">
      <view class="form-label">证件信息补充（仅姓名可公开）</view>
      <view class="privacy-warning">强提醒：请遮挡证号、地址和照片敏感信息，姓名可不遮挡。</view>
      <view class="cert-actions">
        <button class="ai-btn cert-action-btn" bindtap="autoFillIdCardByOcr" loading="{{idCardOcrLoading}}">证件OCR自动提取</button>
        <button class="ai-btn cert-action-btn cert-manual-btn" bindtap="showManualCertFields" wx:if="{{!certInfoVisible}}">手动补录字段</button>
      </view>
      <view class="cert-hint">先点击 OCR 自动提取，再核对信息；识别有误请手动修改。</view>
      <view class="cert-fields" wx:if="{{certInfoVisible}}">
        <view wx:if="{{certFieldVisible.name}}" class="cert-field-row">
          <view class="cert-field-label">姓名：</view>
          <input type="text" class="cert-field-input" placeholder="请输入姓名" value="{{formData.idCardName}}" bindinput="onIdCardNameChange" />
        </view>
        <view wx:if="{{certFieldVisible.idNo}}" class="cert-field-row">
          <view class="cert-field-label">证件号：</view>
          <input type="text" class="cert-field-input" placeholder="请输入证件号" value="{{formData.idCardNo}}" bindinput="onIdCardNoChange" />
        </view>
        <view wx:if="{{certFieldVisible.studentNo}}" class="cert-field-row">
          <view class="cert-field-label">学号：</view>
          <input type="text" class="cert-field-input" placeholder="请输入学号" value="{{formData.studentNo}}" bindinput="onStudentNoChange" />
        </view>
        <view wx:if="{{certFieldVisible.college}}" class="cert-field-row">
          <view class="cert-field-label">学院：</view>
          <input type="text" class="cert-field-input" placeholder="请输入学院" value="{{formData.college}}" bindinput="onCollegeChange" />
        </view>
        <view wx:if="{{certFieldVisible.major}}" class="cert-field-row">
          <view class="cert-field-label">专业：</view>
          <input type="text" class="cert-field-input" placeholder="请输入专业" value="{{formData.major}}" bindinput="onMajorChange" />
        </view>
        <view wx:if="{{certFieldVisible.address}}" class="cert-field-block">
          <view class="cert-field-label">地址：</view>
          <textarea class="form-textarea cert-address-textarea" placeholder="请输入地址（仅加密存储）" value="{{formData.idCardAddress}}" bindinput="onIdCardAddressChange" maxlength="200"></textarea>
        </view>
      </view>
    </view>
    
    <view class="form-section">
      <view class="form-label">物品名称</view>
      <input type="text" class="form-input" placeholder="请输入物品名称" value="{{formData.title}}" bindinput="onTitleChange" />
    </view>
    
    <view class="form-section">
      <view class="form-label">详细描述</view>
      <textarea class="form-textarea" placeholder="请描述物品的颜色、品牌、特征等，越详细越容易找到..." value="{{formData.description}}" bindinput="onDescriptionChange" maxlength="200"></textarea>
      <view class="form-counter">{{formData.description.length}}/200</view>
    </view>
    
    <view class="form-section">
      <view class="form-label">丢失时间</view>
      <view class="form-select">
        <picker mode="date" value="{{formData.lostDate}}" bindchange="onDateChange">
          <view>{{formData.lostDate}}</view>
        </picker>
        <picker mode="time" value="{{formData.lostTime}}" bindchange="onTimeChange">
          <view>{{formData.lostTime}}</view>
        </picker>
      </view>
    </view>
    
    <view class="form-section">
      <view class="form-label">丢失地点</view>
      <view class="form-select" bindtap="chooseLocation">
        {{formData.location || '选择地点'}}
        <view class="form-arrow">></view>
      </view>
    </view>
    
    <view class="form-section">
      <view class="form-label">联系方式</view>
      <view class="contact-options">
        <view class="contact-option {{selectedContactMethod === 'phone' ? 'active' : ''}}" bindtap="selectContactMethod" data-method="phone">
          手机号
        </view>
        <view class="contact-option {{selectedContactMethod === 'wechat' ? 'active' : ''}}" bindtap="selectContactMethod" data-method="wechat">
          微信号
        </view>
      </view>
      <input type="text" class="form-input" placeholder="请输入联系方式" value="{{formData.contactInfo}}" bindinput="onContactChange" />
    </view>
  </view>
  
  <view class="publish-submit">
    <button class="clear-btn" bindtap="clearForm">清空内容</button>
    <button class="submit-btn" bindtap="submitPublish">{{submitText}}</button>
  </view>
</view>