<view class="container">
  <view class="home-header">
    <view>
      <view class="home-header-title">校园失物招领</view>
      <view class="home-header-subtitle">西南大学校园平台</view>
    </view>
    <view class="home-header-icon">
      🔔
    </view>
  </view>
  
  <view class="search-bar">
    <view class="search-input">
      🔍
      <input type="text" placeholder="搜索失物或招领..." bindinput="onSearchInput" bindconfirm="handleSearch" />
      <button class="img-search-btn" bindtap="goToSmartSearch">文/图搜</button>
      <button class="filter-btn" bindtap="handleSearch">筛选</button>
    </view>
  </view>
  
  <view class="tab-nav">
    <view class="tab-item {{currentTab === 'lost' ? 'active' : ''}}" bindtap="switchTab" data-type="lost">
      🔍 寻物启事
    </view>
    <view class="tab-item {{currentTab === 'found' ? 'active' : ''}}" bindtap="switchTab" data-type="found">
      📋 失物招领
    </view>
  </view>
  
  <view class="category-nav">
    <view class="category-item {{currentCategory === '全部' ? 'active' : ''}}" bindtap="switchCategory" data-category="全部">全部</view>
    <view class="category-item {{currentCategory === '电子设备' ? 'active' : ''}}" bindtap="switchCategory" data-category="电子设备">电子设备</view>
    <view class="category-item {{currentCategory === '证件' ? 'active' : ''}}" bindtap="switchCategory" data-category="证件">证件</view>
    <view class="category-item {{currentCategory === '服装' ? 'active' : ''}}" bindtap="switchCategory" data-category="服装">服装</view>
    <view class="category-item {{currentCategory === '其他' ? 'active' : ''}}" bindtap="switchCategory" data-category="其他">其他</view>
  </view>
  
  <view class="success-banner">
    ✅ 本周已成功帮助 47 位同学找回失物
  </view>
  
  <view class="items-grid">
    <view class="item-card" wx:for="{{items}}" wx:key="id" bindtap="handleItemClick" data-id="{{item.id}}">
      <view class="item-image">
        <image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" class="item-cover" data-id="{{item.id}}" binderror="onImageError"></image>
        <view wx:else class="item-cover empty-cover">暂无图片</view>
        <view class="item-tag">{{item.type === 'lost' ? '寻物' : '招领'}}</view>
        <view class="item-tag" style="left: auto; right: 8px; background-color: #5c6bc0;">{{item.statusLabel}}</view>
      </view>
      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view wx:if="{{item.similarity !== undefined}}" class="sim-tag">匹配度 {{item.similarityText}}</view>
        <view wx:if="{{item.certMatch}}" class="cert-match-tag">证件匹配</view>
        <view class="item-location">{{item.location}} · {{item.date}}</view>
        <view style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
          <view class="item-user">{{item.user}}</view>
          <view class="item-views">{{item.views}} 浏览</view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="publish-btn" bindtap="goToPublish">+</view>
</view>